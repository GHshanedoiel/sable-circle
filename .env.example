# GEMINI_API_KEY: Required for Gemini AI API calls & semantic hook analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: Local SQLite database file for Drizzle ORM
DATABASE_URL="file:./sable_circle.db"

# NEXTAUTH / JWT secret for multi-user authentication
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# FFMPEG_PATH: Optional explicit path if FFmpeg is not in system PATH
# FFMPEG_PATH="/usr/local/bin/ffmpeg"

